# ==============================================================================
# Bestlink College of the Philippines — Alumni Portal Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite / Netlify)
# ------------------------------------------------------------------------------
# Your Supabase project URL and anonymous API key (safe for browser exposure)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Application Settings
VITE_APP_NAME="BCP Alumni Portal"
VITE_APP_URL=http://localhost:5175

# Optional Diagnostics (Set to true only for local debugging)
VITE_VERBOSE_DEBUG_TOASTS=false

# ------------------------------------------------------------------------------
# 2. Supabase Edge Functions & Vault Secrets (Backend Only — DO NOT EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# In Supabase Dashboard → Settings → Vault / Edge Functions Secrets, add:
#
# BREVO_API_KEY=xkeysib-your-brevo-api-key-here
# BREVO_SENDER_EMAIL=alumni-affairs@bcp.edu.ph
# BREVO_SENDER_NAME="Bestlink College of the Philippines Alumni Affairs"
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# ==============================================================================
